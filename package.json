{
  "name": "feliz-cristais-impressora",
  "productName": "Feliz Cristais Gestão",
  "version": "2.0.1",
  "description": "Painel da loja Feliz Cristais no computador: avisos de pedidos e atendimento na hora, contador de pendências e impressão automática dos pedidos (Windows e Mac).",
  "main": "src/main.js",
  "author": "Feliz Cristais",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "br.com.felizcristais.impressora",
    "productName": "Feliz Cristais Gestão",
    "copyright": "Feliz Cristais",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "JEAN-ALMEIDA-CZO",
        "repo": "feliz-cristais-impressora",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Feliz-Cristais-Gestao-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Feliz Cristais Gestão",
      "runAfterFinish": true,
      "language": "1046",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "artifactName": "Feliz-Cristais-Gestao-Mac.${ext}",
      "extendInfo": {
        "LSUIElement": false
      }
    },
    "dmg": {
      "title": "Feliz Cristais Gestão"
    },
    "fileAssociations": [
      {
        "ext": "fcprint",
        "name": "Configuração Feliz Cristais",
        "description": "Configuração do app Feliz Cristais Gestão",
        "role": "Viewer"
      }
    ]
  }
}
